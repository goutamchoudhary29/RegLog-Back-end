{
  "info": {
    "name": "RegLog Secure Auth API",
    "description": "Registration, login, JWT HttpOnly cookie session, password reset, and change password endpoints. Enable Postman's cookie jar and call /api/csrf before state-changing requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "email", "value": "demo@example.com" },
    { "key": "mobile", "value": "9876543210" },
    { "key": "password", "value": "Strong#Pass123" },
    { "key": "resetToken", "value": "" }
  ],
  "item": [
    {
      "name": "Get CSRF token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/csrf"
      },
      "response": []
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Demo User\",\n  \"email\": \"{{email}}\",\n  \"mobileNumber\": \"{{mobile}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-XSRF-TOKEN", "value": "{{xsrf}}" }],
        "url": "{{baseUrl}}/auth/logout"
      }
    },
    {
      "name": "Forgot password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/forgot-password"
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/auth/verify-otp"
      }
    },
    {
      "name": "Reset password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"NewStrong#Pass123\",\n  \"confirmPassword\": \"NewStrong#Pass123\"\n}"
        },
        "url": "{{baseUrl}}/auth/reset-password"
      }
    },
    {
      "name": "Change password",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-XSRF-TOKEN", "value": "{{xsrf}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"Changed#Pass123\",\n  \"confirmPassword\": \"Changed#Pass123\"\n}"
        },
        "url": "{{baseUrl}}/auth/change-password"
      }
    }
  ]
}
